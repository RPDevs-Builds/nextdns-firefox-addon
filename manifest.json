{
  "manifest_version": 3,
  "name": "DNS Forge",
  "version": "1.1.0",
  "description": "Comprehensive NextDNS management tool: blocklists, allowlists, live query logs, analytics, scheduling, and web UI enhancements.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "menus",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://api.nextdns.io/*",
    "https://test.nextdns.io/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "type": "module",
    "scripts": [
      "src/background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.nextdns.io/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/domSelectors.json",
        "data/blocks_meta.json"
      ],
      "matches": [
        "https://my.nextdns.io/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{56fda99b-4dd4-4a4a-a413-00ff1c2cffd8}",
      "update_url": "https://raw.githubusercontent.com/RPDevs-Builds/nextdns-firefox-addon/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  },
  "sidebar_action": {
    "default_title": "DNS Forge",
    "default_panel": "src/popup.html?mode=sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
